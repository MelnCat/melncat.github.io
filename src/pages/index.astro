import Layout from "../layouts/Layout.astro";
---

<Layout title="melncat">
	<MainContainer>
		<div class="sticker-container">
			<MelncatSticker client:load />
		</div>
		<p>Hello! I don't really have anything to say here.</p>
	</MainContainer>
</Layout>

<style>
    .sticker-container {
        display: flex;
        padding: var(--space-4);
    }
	header {
		text-align: center;
	}
</style>
