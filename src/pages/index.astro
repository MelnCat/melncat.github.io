---
import MainContainer from "../components/MainContainer.astro";
import MelncatSticker from "../components/MelncatSticker.svelte";
import Layout from "../layouts/Layout.astro";
---

<Layout title="melncat">
	<MainContainer>
		<div class="sticker-container">
			<MelncatSticker client:load />
		</div>
		<p>Hello! I don't really have anything to say here.</p>
		<h1>Profiles</h1>
		<div class="profiles">
			<div class="accounts">
				<a href="https://github.com/melncat">[Github]</a>
				<a href="https://modrinth.com/user/melncat">[Modrinth]</a>
				<a href="https://www.curseforge.com/members/melncat">[Curseforge]</a>
			</div>
			<div class="other">
				<div>
					<span data-obfuscation>Email: <b>melncat@crab.trade</b></span>
				</div>
				<div>Discord: <b>melncat</b></div>
			</div>
		</div>
	</MainContainer>
</Layout>

<style>
	.profiles {
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
    .other {
        text-align: left;
    }
	.sticker-container {
		display: flex;
		padding: var(--space-4);
	}
	.accounts {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	header {
		text-align: center;
	}
</style>
